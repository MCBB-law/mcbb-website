---
import Base from '../../layouts/Base.astro';
import PersonCard from '../../components/PersonCard.astro';
import { practices, type Practice } from '../../data/practices';
import { getPeople, practiceSlugsFor } from '../../data/people';
import { site, PREVIEW } from '../../data/site';

export function getStaticPaths() {
  return practices.map((p) => ({ params: { slug: p.slug }, props: { practice: p } }));
}
const { practice } = Astro.props as { practice: Practice };
const team = (await getPeople()).filter((p) => practiceSlugsFor(p).includes(practice.slug));
const others = practices.filter((p) => p.slug !== practice.slug);
const contactEmail = practice.email ?? site.email;
---
<Base title={practice.title} description={practice.summary}>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow"><a href="/practices/">Practices</a></p>
      <h1>{practice.title}</h1>
      <p class="lede">{practice.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap layout">
      <article class="prose">
        {PREVIEW && practice.draft && <p class="draft-note"><strong>Draft note:</strong> {practice.draft}</p>}
        {practice.intro.map((para) => <p>{para}</p>)}
        {practice.sections.map((s) => (
          <>
            {s.heading && <h2>{s.heading}</h2>}
            {s.body?.map((para) => <p>{para}</p>)}
            {s.list && <ul class="cols">{s.list.map((li) => <li>{li}</li>)}</ul>}
          </>
        ))}
        {practice.outro?.map((para) => <p>{para}</p>)}
      </article>

      <aside>
        <div class="card sticky">
          <p class="eyebrow">Talk to our team</p>
          <p>To speak with a lawyer in this practice, email <a href={`mailto:${contactEmail}`}>{contactEmail}</a> or call <a href={site.phoneHref}>{site.phone}</a>.</p>
          <a class="btn" href="/contact/">Contact us</a>
        </div>
        <nav class="others" aria-label="Other practices">
          <p class="eyebrow">Other practices</p>
          <ul>{others.map((o) => <li><a href={`/practices/${o.slug}/`}>{o.title}</a></li>)}</ul>
        </nav>
      </aside>
    </div>
  </section>

  {team.length > 0 && (
    <section class="section section--tint">
      <div class="wrap">
        <p class="eyebrow">Lawyers in this practice</p>
        <div class="grid grid-4">{team.map((p) => <PersonCard person={p} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .page-head .eyebrow a { color: inherit; text-decoration: none; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .prose > p:first-of-type:not(.draft-note), .prose > .draft-note + p { font-size: 1.12rem; }
  .cols { columns: 2 260px; column-gap: 32px; }
  .cols li { break-inside: avoid; }
  .sticky { position: sticky; top: 100px; }
  .sticky p:not(.eyebrow) { font-size: .95rem; }
  .others { margin-top: 32px; }
  .others ul { list-style: none; padding: 0; margin: 0; }
  .others li { border-bottom: 1px solid var(--line); }
  .others a { display: block; padding: 10px 0; text-decoration: none; font-size: .95rem; }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } .sticky { position: static; } }
</style>
