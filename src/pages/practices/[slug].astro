---
import Base from '../../layouts/Base.astro';
import PersonCard from '../../components/PersonCard.astro';
import { practices, type Practice } from '../../data/practices';
import { getPeople, practiceSlugsFor, initials } from '../../data/people';
import { site, PREVIEW } from '../../data/site';

export function getStaticPaths() {
  return practices.map((p) => ({ params: { slug: p.slug }, props: { practice: p } }));
}
const { practice } = Astro.props as { practice: Practice };
const team = (await getPeople()).filter((p) => practiceSlugsFor(p).includes(practice.slug));
const others = practices.filter((p) => p.slug !== practice.slug);
const contactEmail = practice.email ?? site.email;
const sectionLinks = practice.sections.filter((x) => x.heading).map((x) => ({ text: x.heading, id: x.heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') }));
---
<Base title={practice.title} description={practice.summary}>
  <section class="ph">
    <div class="wrap">
      <p class="eyebrow"><a href="/practices/">Practices</a></p>
      <div class="ph-grid reveal">
        <h1>{practice.title}</h1>
        <div class="ph-side">
          <p class="ph-lede">{practice.summary}</p>
          {team.length > 0 && (
            <a class="faces" href="#team">
              <span class="stack" aria-hidden="true">
                {team.slice(0, 8).map((m) => m.data.photo
                  ? <img src={m.data.photo} alt="" width="48" height="60" loading="lazy" />
                  : <span class="ini">{initials(m.data.name)}</span>)}
              </span>
              <span class="faces-label">{team.length} {team.length === 1 ? 'lawyer' : 'lawyers'} in this practice</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap layout">
      <article class="prose reveal">
        {PREVIEW && practice.draft && <p class="draft-note"><strong>Draft note:</strong> {practice.draft}</p>}
        {practice.intro.map((para) => <p>{para}</p>)}
        {practice.figure && (
          <figure class="figure">
            <img src={practice.figure.src} alt={practice.figure.alt} loading="lazy" />
            <figcaption>{practice.figure.caption}</figcaption>
          </figure>
        )}
        {practice.sections.map((s) => (
          <>
            {s.heading && <h2 id={s.heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}>{s.heading}</h2>}
            {s.body?.map((para) => <p>{para}</p>)}
            {s.list && <ul class="cols">{s.list.map((li) => <li>{li}</li>)}</ul>}
          </>
        ))}
        {practice.outro?.map((para) => <p>{para}</p>)}
      </article>

      <aside>
        <div class="stick">
        {sectionLinks.length >= 3 && (
          <nav class="toc" aria-label="On this page">
            <p class="eyebrow">On this page</p>
            <ul>{sectionLinks.map((l) => <li><a href={`#${l.id}`}>{l.text}</a></li>)}</ul>
          </nav>
        )}
        <div class="card talk">
          <p class="eyebrow">Talk to our team</p>
          <p>To speak with a lawyer in this practice, email <a href={`mailto:${contactEmail}`}>{contactEmail}</a> or call <a href={site.phoneHref}>{site.phone}</a>.</p>
          <a class="btn" href="/contact/">Contact us</a>
        </div>
        </div>
      </aside>
    </div>
  </section>

  {team.length > 0 && (
    <section class="section section--tint" id="team">
      <div class="wrap">
        <p class="eyebrow">Lawyers in this practice</p>
        <div class="grid grid-4 reveal-stagger">{team.map((p) => <PersonCard person={p} />)}</div>
      </div>
    </section>
  )}

  <section class="section others">
    <div class="wrap">
      <p class="eyebrow">Other practices</p>
      <ul class="line-grid">{others.map((o) => <li><a href={`/practices/${o.slug}/`}><span>{o.title}</span><span class="arrow" aria-hidden="true">→</span></a></li>)}</ul>
    </div>
  </section>
</Base>

<style>
  /* Practice header: large type on a dark band, with the practice's lawyers instead of a photo */
  .ph { background: var(--ink); color: #fff; padding: clamp(64px, 9vw, 120px) 0 clamp(48px, 6vw, 80px); }
  .ph .eyebrow { color: rgba(255,255,255,.7); }
  .ph .eyebrow a { color: inherit; text-decoration: none; }
  .ph .eyebrow a:hover { text-decoration: underline; }
  .ph-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: end; }
  .ph h1 { color: #fff; font-size: clamp(2.6rem, 6.4vw, 5.4rem); line-height: 1; margin: 0; }
  .ph-side { border-left: 1px solid rgba(255,255,255,.22); padding-left: clamp(20px, 3vw, 40px); }
  .ph-lede { font-size: 1.15rem; line-height: 1.6; color: rgba(255,255,255,.8); margin: 0 0 28px; }
  .faces { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; text-decoration: none; color: #fff; }
  .stack { display: flex; }
  .stack img, .stack .ini { width: 44px; height: 55px; object-fit: cover; object-position: center 20%; filter: grayscale(1); border: 2px solid var(--ink); margin-left: -10px; background: #333; transition: filter .3s, transform .3s var(--ease); }
  .stack > :first-child { margin-left: 0; }
  .stack .ini { display: grid; place-items: center; font-family: var(--display); font-size: .8rem; letter-spacing: .08em; }
  .faces:hover .stack img { filter: grayscale(0); }
  .faces-label { font-size: .78rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .faces-label::after { content: ' →'; letter-spacing: 0; }
  .faces:hover .faces-label { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 860px) { .ph-grid { grid-template-columns: 1fr; } .ph-side { border-left: 0; padding-left: 0; border-top: 1px solid rgba(255,255,255,.22); padding-top: 24px; } }

  /* On-this-page index */
  .toc { margin-bottom: 32px; }
  .toc ul { list-style: none; padding: 0; margin: 0; border-left: 1px solid var(--line); }
  .toc a { display: block; padding: 6px 0 6px 16px; margin-left: -1px; border-left: 1px solid transparent; text-decoration: none; font-size: .9rem; color: var(--muted); }
  .toc a:hover { color: var(--ink); border-left-color: var(--ink); }
  .prose :global(h2[id]) { scroll-margin-top: 100px; }
  aside { align-self: stretch; }
  .stick { position: sticky; top: 100px; max-height: calc(100vh - 120px); overflow-y: auto; }
  .figure { margin: 2.4em 0; border: 1px solid var(--line); background: #fff; padding: clamp(16px, 3vw, 32px); }
  .figure img { width: 100%; max-width: 520px; margin: 0 auto; }
  .figure figcaption { margin-top: 14px; font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); text-align: center; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .prose > p:first-of-type:not(.draft-note), .prose > .draft-note + p { font-size: 1.2rem; line-height: 1.6; color: var(--ink); }
  .prose :global(h2) { padding-top: 1.2em; border-top: 1px solid var(--line); }
  .cols li { list-style: none; position: relative; padding-left: 20px; }
  .cols li::before { content: ''; position: absolute; left: 0; top: .8em; width: 10px; height: 1px; background: var(--ink); }
  .cols { padding-left: 0 !important; }
  .cols { columns: 2 260px; column-gap: 32px; }
  .cols li { break-inside: avoid; }
  .talk p:not(.eyebrow) { font-size: .95rem; }
  .others ul { list-style: none; padding: 0; margin: 0; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  .others ul.line-grid { background: none; border: 0; gap: 0; }
  .others li { margin: 0 -1px -1px 0; border: 1px solid var(--line); background: var(--paper); }
  .others a { display: flex; justify-content: space-between; align-items: center; gap: 16px; height: 100%; padding: 22px 24px; text-decoration: none; font-family: var(--display); text-transform: uppercase; letter-spacing: .05em; font-size: 1rem; }
  .others a:hover { background: var(--ink); color: #fff; }
  .others .arrow { transition: transform .25s var(--ease); }
  .others a:hover .arrow { transform: translateX(5px); }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } .stick { position: static; max-height: none; } .toc { display: none; } }
</style>
