---
import PageHero from '../../components/PageHero.astro';
import { pageImages } from '../../data/images';
import Base from '../../layouts/Base.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getPeople } from '../../data/people';

const people = await getPeople();
const partners = people.filter((p) => p.data.title === 'Partner');
const others = people.filter((p) => p.data.title !== 'Partner');
---
<Base title="People" description="Meet the lawyers of Manning Curtis Bradshaw & Bednar.">
  <PageHero
    eyebrow="People"
    title="Sharp. Experienced. People-first."
    lede="Many of our lawyers served as law review editors and judicial clerks before trying cases. Here’s who you’ll work with."
    image={pageImages.people.src}
    alt={pageImages.people.alt}
    position={pageImages.people.position}
  />
  <section class="section">
    <div class="wrap">
      <h2 class="group">Partners</h2>
      <div class="grid grid-4">{partners.map((p) => <PersonCard person={p} />)}</div>
      <h2 class="group">Associates</h2>
      <div class="grid grid-4">{others.map((p) => <PersonCard person={p} />)}</div>
    </div>
  </section>
</Base>

<style>
  .group { font-size: 1.4rem; border-bottom: 1px solid var(--line); padding-bottom: .5rem; margin-bottom: 1.5rem; }
  .group:not(:first-child) { margin-top: 4rem; }
</style>
