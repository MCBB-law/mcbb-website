---
import PageHero from '../../components/PageHero.astro';
import { pageImages } from '../../data/images';
import Base from '../../layouts/Base.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getPeople } from '../../data/people';

const people = await getPeople();
---
<Base title="People" description="Meet the lawyers of Manning Curtis Bradshaw & Bednar.">
  <PageHero
    eyebrow="People"
    title="Sharp. Experienced. People-first."
    lede="Many of our lawyers served as law review editors and judicial clerks before trying cases. Here’s who you’ll work with."
    image={pageImages.people.src}
    alt={pageImages.people.alt}
    position={pageImages.people.position}
  />
  <section class="section">
    <div class="wrap">
      <div class="grid team reveal-stagger">{people.map((p) => <PersonCard person={p} />)}</div>
    </div>
  </section>
</Base>

<style>
  .team { grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 36px 24px; }
  @media (max-width: 520px) { .team { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 16px; } }
</style>
