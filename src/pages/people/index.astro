---
import Base from '../../layouts/Base.astro';
import PersonCard from '../../components/PersonCard.astro';
import { people } from '../../data/people';
import { PREVIEW } from '../../data/site';
---
<Base title="People" description="Meet the lawyers of Manning Curtis Bradshaw & Bednar.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">People</p>
      <h1>Sharp. Experienced. People-first.</h1>
      <p class="lede">Most of our lawyers served as law review editors and judicial clerks before trying cases. Here’s who you’ll work with.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      {PREVIEW && <p class="draft-note"><strong>Draft note:</strong> This roster is incomplete. Titles, bios, and headshots still need to be copied from the current site.</p>}
      <div class="grid grid-4">{people.map((p) => <PersonCard person={p} />)}</div>
    </div>
  </section>
</Base>
