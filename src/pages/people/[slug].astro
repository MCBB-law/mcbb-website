---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPeople, initials, practiceSlugsFor, type Person } from '../../data/people';
import { practices } from '../../data/practices';
import { site, PREVIEW } from '../../data/site';

export async function getStaticPaths() {
  const people = await getPeople();
  return people.map((p) => ({ params: { slug: p.id }, props: { person: p } }));
}
const { person } = Astro.props as { person: Person };
const d = person.data;
const { Content } = await render(person);
// Split the rendered bio at each "## " heading. Short credential sections (education, admissions,
// clerkships, languages, affiliations, honors) go in the right-hand column; everything else stays in the main text.
const SIDE = /^(education|licenses|clerkship|languages|professional affiliations|professional recognitions)/i;
const bioHtml: string = (person as any).rendered?.html ?? '';
const parts = bioHtml.split(/(?=<h2[\s>])/);
const intro = (parts[0] ?? '').replace('<p>', '<p class="lead">');
const sections = parts.slice(1).map((h) => ({ html: h, title: (h.match(/<h2[^>]*>([\s\S]*?)<\/h2>/)?.[1] ?? '').replace(/<[^>]+>/g, '').trim() }));
// An entry written as "School\" + new line + "Degree · Year" shows the school on top and the details below in gray.
const sideSections = sections.filter((x) => SIDE.test(x.title)).map((x) => ({ ...x, html: x.html.replace(/<li>([^<]+)<br\s*\/?>\s*([^<]+)/g, '<li><span class="sc">$1</span><span class="mj">$2</span>') }));
const mainSections = sections.filter((x) => !SIDE.test(x.title));
const mine = practiceSlugsFor(person);
const myPractices = practices.filter((p) => mine.includes(p.slug));
const telHref = d.phone ? 'tel:+1' + d.phone.replace(/\D/g, '') : site.phoneHref;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: d.name,
  jobTitle: d.title,
  worksFor: { '@type': 'LegalService', name: site.name },
  ...(d.email ? { email: d.email } : {}),
  ...(d.phone ? { telephone: d.phone } : {}),
};
---
<Base title={d.name} metaTitle={d.metaTitle} description={d.metaDescription ?? `${d.name}, ${d.title.toLowerCase()} at ${site.name}. ${d.practiceAreas.join(', ')}.`}>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <section class="page-head bio-hero">
    <div class="wrap bio-head">
      <div class="photo">
        {d.photo
          ? <img src={d.photo} alt={`Portrait of ${d.name}`} width="400" height="500" />
          : <span aria-hidden="true">{initials(d.name)}</span>}
      </div>
      <div>
        <p class="eyebrow"><a href="/people/">People</a></p>
        <h1>{d.name}</h1>
        <p class="lede">{d.founder ? 'Founding Partner' : d.title}</p>
        <p class="contact">
          {d.phone && <a href={telHref}>{d.phone}</a>}
          {d.email && <a href={`mailto:${d.email}`}>{d.email}</a>}
        </p>
        <p class="areas">{d.practiceAreas.join(' · ')}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap layout">
      <article class="prose bio">
        {PREVIEW && d.draftNote && <p class="draft-note"><strong>Draft note:</strong> {d.draftNote}</p>}
        {bioHtml ? <Fragment set:html={intro + mainSections.map((x) => x.html).join('')} /> : <Content />}
      </article>
      <aside>
        <div class="side-creds">
          {myPractices.length > 0 && (
            <>
              <h2>Practices</h2>
              <ul class="practice-links">{myPractices.map((p) => <li><a href={`/practices/${p.slug}/`}><span>{p.title}</span><span class="arrow" aria-hidden="true">→</span></a></li>)}</ul>
            </>
          )}
          {sideSections.map((x) => <Fragment set:html={x.html} />)}
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .page-head .eyebrow a { color: inherit; text-decoration: none; }
  /* Dark header band */
  .bio-hero { background: var(--ink); border-bottom: 0; padding: clamp(56px, 7vw, 88px) 0 clamp(44px, 6vw, 64px); }
  .bio-hero h1, .bio-hero .contact a { color: #fff; }
  .bio-hero .lede { color: rgba(255,255,255,.75); }
  .bio-hero .areas { color: rgba(255,255,255,.55); }
  .bio-hero .eyebrow { color: rgba(255,255,255,.7); }
  .bio-hero .contact a:hover { color: rgba(255,255,255,.7); }
  .bio-hero .photo span { color: #fff; }
  .bio-head { display: grid; grid-template-columns: 300px 1fr; gap: clamp(24px, 4vw, 48px); align-items: end; }
  .photo {
    aspect-ratio: 4 / 5; border-radius: var(--radius); overflow: hidden;
    background: linear-gradient(160deg, #3a3a3a, #0d0d0d);
    display: grid; place-items: center;
  }
  .photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; filter: grayscale(1) contrast(1.05); }
  .photo span { font-family: var(--display); font-size: 3.2rem; color: #fff; letter-spacing: .1em; }
  .page-head h1 { font-size: clamp(2.3rem, 5vw, 4rem); }
  .page-head .lede { margin-bottom: .6rem; }
  .contact { display: flex; flex-wrap: wrap; gap: 6px 24px; margin: 0 0 .6rem; font-weight: 500; }
  .areas { color: var(--muted); font-size: .92rem; margin: 0; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: clamp(32px, 5vw, 72px); align-items: start; }

  /* Credentials in the right-hand column */
  /* Every block in the right-hand column (Practices included) uses the site's standard label style (.eyebrow in global.css). */
  .side-creds :global(h2) { font-family: var(--sans); font-size: .74rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--clay); margin: 34px 0 8px; display: flex; align-items: center; gap: 12px; }
  .side-creds > :global(h2:first-child) { margin-top: 0; }
  .side-creds :global(h2)::before { content: ''; width: 28px; height: 2px; background: var(--clay); flex: none; }
  .side-creds :global(ul) { list-style: none; margin: 0; padding: 0; }
  .side-creds :global(li) { font-size: .92rem; line-height: 1.45; padding: 8px 0; border-bottom: 1px solid var(--line); }
  .side-creds :global(li ul) { margin-top: 4px; }
  .side-creds :global(li li) { border: 0; padding: 2px 0 2px 14px; color: var(--muted); font-size: .86rem; position: relative; }
  .side-creds :global(li li)::before { content: '–'; position: absolute; left: 0; }
  .side-creds :global(p) { font-size: .92rem; line-height: 1.5; }
  .side-creds :global(.sc) { display: block; color: var(--ink); }
  .side-creds :global(.mj) { display: block; margin-top: 2px; color: var(--muted); font-size: .84rem; }
  .practice-links a { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; text-decoration: none; color: var(--ink); }
  .practice-links a:hover { color: var(--clay-dark); }
  .practice-links .arrow { opacity: 0; transform: translateX(-4px); transition: opacity .2s, transform .2s var(--ease); }
  .practice-links a:hover .arrow { opacity: 1; transform: none; }

  /* Bio body (Markdown) */
  .bio :global(p.lead) { font-size: 1.3rem; line-height: 1.55; color: var(--ink); }
  .bio :global(p) { font-size: 1.05rem; }
  .bio :global(h2) { font-size: 1.05rem; font-family: var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin: 2.4em 0 .8em; }
  .bio :global(h3) { font-size: 1.15rem; margin: 1.4em 0 .5em; }
  .bio :global(ul) { list-style: none; padding: 0; margin: 0 0 1em; }
  .bio :global(li) { padding: 7px 0; border-bottom: 1px solid var(--line); margin: 0; }
  .bio :global(li ul) { margin: 4px 0 0; }
  .bio :global(li li) { border-bottom: 0; padding: 2px 0 2px 18px; color: var(--muted); font-size: .95rem; position: relative; }
  .bio :global(li li)::before { content: '–'; position: absolute; left: 2px; color: var(--accent); }

  .bio :global(details) { margin: 1.2em 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--white); }
  .bio :global(summary) { cursor: pointer; padding: 12px 16px; font-weight: 600; color: var(--ink); }
  .bio :global(summary:hover) { color: var(--accent); }
  .bio :global(details ul) { padding: 0 16px 8px; }
  .bio :global(details li) { font-size: .93rem; }

  @media (max-width: 860px) {
    .bio-head { grid-template-columns: 180px 1fr; align-items: center; }
    .bio :global(p.lead) { font-size: 1.15rem; }
    .layout { grid-template-columns: 1fr; }
    aside .card { position: static; }
  }
  @media (max-width: 520px) { .bio-head { grid-template-columns: 1fr; } .photo { max-width: 220px; } }
</style>
