---
import { initials, type Person } from '../data/people';
interface Props { person: Person }
const { person } = Astro.props;
const d = person.data;
---
<a class="person" href={`/people/${person.id}/`}>
  <div class="photo">
    {d.photo
      ? <img src={d.photo} alt={`Portrait of ${d.name}`} loading="lazy" width="400" height="500" />
      : <span aria-hidden="true">{initials(d.name)}</span>}
  </div>
  <p class="name">{d.name}</p>
  <p class="title">{d.founder ? 'Founding Partner' : d.title}</p>
</a>

<style>
  .person { display: block; text-decoration: none; color: inherit; }
  .photo {
    aspect-ratio: 4 / 5;
    background: linear-gradient(160deg, var(--ink-2), var(--ink));
    display: grid;
    place-items: center;
    overflow: hidden;
    margin-bottom: 14px;
    border-radius: var(--radius);
  }
  .photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; transition: transform .3s; }
  .photo span { font-family: var(--serif); font-size: 3rem; color: var(--brass-light); letter-spacing: .05em; }
  .person:hover img { transform: scale(1.03); }
  .name { font-family: var(--serif); font-size: 1.15rem; font-weight: 600; color: var(--ink); margin: 0; line-height: 1.25; }
  .person:hover .name { color: var(--brass); }
  .title { color: var(--muted); font-size: .9rem; margin: 2px 0 0; }
</style>
