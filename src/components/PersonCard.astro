---
import { initials, type Person } from '../data/people';
interface Props { person: Person }
const { person } = Astro.props;
const d = person.data;
---
<a class="person" href={`/people/${person.id}/`}>
  <div class="photo">
    {d.photo
      ? <img src={d.photo} alt={`Portrait of ${d.name}`} loading="lazy" width="400" height="500" />
      : <span aria-hidden="true">{initials(d.name)}</span>}
  </div>
  <p class="name">{d.name}</p>
  <p class="title">{d.founder ? 'Founding Partner' : d.title}</p>
</a>

<style>
  .person { display: block; text-decoration: none; color: inherit; }
  .photo {
    aspect-ratio: 4 / 5;
    background: linear-gradient(160deg, #3a3a3a, #0d0d0d);
    display: grid;
    place-items: center;
    overflow: hidden;
    margin-bottom: 14px;
    border-radius: var(--radius);
  }
  .photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; filter: grayscale(1) contrast(1.05); transition: transform .6s var(--ease), filter .4s; }
  .photo span { font-family: var(--display); font-size: 2.8rem; color: #fff; letter-spacing: .1em; }
  .person:hover img { transform: scale(1.04); filter: grayscale(0); }
  .name { font-family: var(--display); font-size: 1.05rem; font-weight: 500; text-transform: uppercase; letter-spacing: .04em; color: var(--ink); margin: 0; line-height: 1.25; }
  .person:hover .name { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .title { color: var(--muted); font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; margin: 4px 0 0; }
</style>
